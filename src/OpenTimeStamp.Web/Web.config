<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Leave blank to use App_Data. Production deployments should use an ACL-protected ProgramData directory. -->
    <add key="DataPath" value="" />
    <!-- Immutable deployment setting; the IIS installer configures matching authentication modules. -->
    <add key="AuthenticationMode" value="Anonymous" />
    <!-- Comma-separated exact Host values allowed for local administration. -->
    <add key="AdminHostNames" value="localhost,127.0.0.1,::1" />
    <!-- Total wall-clock deadline for receiving one timestamp request body. Valid range: 1-25 seconds. -->
    <add key="TimestampBodyReadTimeoutSeconds" value="10" />
    <!-- Concurrent body reads across worker processes. Valid range: 1-256. -->
    <add key="TimestampBodyIntakeLimit" value="32" />
    <!-- Concurrent body reads allowed from one direct transport peer; must not exceed the global intake limit. -->
    <add key="TimestampBodyIntakePerClientLimit" value="4" />
    <!-- Concurrent signing and durable-audit operations across worker processes. Valid range: 1-64. -->
    <add key="TimestampProcessingLimit" value="4" />
    <!-- Concurrent processing operations allowed from one direct transport peer; must not exceed the global limit. -->
    <add key="TimestampProcessingPerClientLimit" value="2" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" executionTimeout="30" maxRequestLength="1024" requestValidationMode="4.5" enableVersionHeader="false" />
    <authentication mode="Windows" />
    <authorization>
      <allow users="*" />
    </authorization>
    <identity impersonate="false" />
    <sessionState mode="Off" />
    <customErrors mode="RemoteOnly" defaultRedirect="" />
    <httpCookies httpOnlyCookies="true" requireSSL="false" sameSite="Strict" />
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <directoryBrowse enabled="false" />
    <staticContent>
      <!-- This application has no static assets; all response media types are emitted by managed handlers. -->
      <clear />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-SourceFiles" />
      </customHeaders>
    </httpProtocol>
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />
    <security>
      <requestFiltering removeServerHeader="true" allowDoubleEscaping="false"
                        allowHighBitCharacters="false">
        <requestLimits maxAllowedContentLength="1048576" maxUrl="2048" maxQueryString="256" />
        <verbs allowUnlisted="false">
          <add verb="GET" allowed="true" />
          <add verb="HEAD" allowed="true" />
          <add verb="POST" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>
    <modules runAllManagedModulesForAllRequests="true">
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>
  </system.webServer>
</configuration>
