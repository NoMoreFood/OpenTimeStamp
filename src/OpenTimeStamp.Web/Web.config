<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Leave blank to use App_Data. Production deployments should use an ACL-protected ProgramData directory. -->
    <add key="DataPath" value="" />
    <!-- Immutable deployment setting; the IIS installer configures matching authentication modules. -->
    <add key="AuthenticationMode" value="Anonymous" />
    <!-- Comma-separated exact Host values allowed for local administration. -->
    <add key="AdminHostNames" value="localhost,127.0.0.1,::1" />
    <!-- Total wall-clock deadline for receiving one timestamp request body. Valid range: 1-25 seconds. -->
    <add key="TimestampBodyReadTimeoutSeconds" value="10" />
    <!-- Concurrent body reads across worker processes. Valid range: 1-256. -->
    <add key="TimestampBodyIntakeLimit" value="32" />
    <!-- Concurrent body reads allowed from one direct transport peer; must not exceed the global intake limit. -->
    <add key="TimestampBodyIntakePerClientLimit" value="4" />
    <!-- Concurrent signing and durable-audit operations across worker processes. Valid range: 1-64. -->
    <add key="TimestampProcessingLimit" value="4" />
    <!-- Concurrent processing operations allowed from one direct transport peer; must not exceed the global limit. -->
    <add key="TimestampProcessingPerClientLimit" value="2" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" executionTimeout="30" maxRequestLength="1024" requestValidationMode="4.5"
                 enableVersionHeader="false" enableHeaderChecking="true" />
    <authentication mode="Windows" />
    <authorization>
      <allow users="*" />
    </authorization>
    <identity impersonate="false" />
    <sessionState mode="Off" cookieless="UseCookies" compressionEnabled="false" />
    <trace enabled="false" pageOutput="false" localOnly="true" />
    <machineKey validation="HMACSHA256" decryption="Auto" compatibilityMode="Framework45"
                validationKey="AutoGenerate,IsolateApps,IsolateByAppId"
                decryptionKey="AutoGenerate,IsolateApps,IsolateByAppId" />
    <customErrors mode="On" defaultRedirect="" />
    <httpCookies httpOnlyCookies="true" requireSSL="false" sameSite="Strict" />
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <directoryBrowse enabled="false" />
    <staticContent>
      <!-- This application has no static assets; all response media types are emitted by managed handlers. -->
      <clear />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-SourceFiles" />
      </customHeaders>
    </httpProtocol>
    <httpErrors errorMode="Custom" existingResponse="Auto" />
    <security>
      <requestFiltering removeServerHeader="true" allowDoubleEscaping="false"
                        allowHighBitCharacters="false">
        <requestLimits maxAllowedContentLength="1048576" maxUrl="2048" maxQueryString="256" />
        <fileExtensions allowUnlisted="false" applyToWebDAV="true">
          <clear />
          <add fileExtension="." allowed="true" />
        </fileExtensions>
        <hiddenSegments applyToWebDAV="true">
          <remove segment="web.config" />
          <remove segment="bin" />
          <remove segment="App_Code" />
          <remove segment="App_Data" />
          <remove segment="App_GlobalResources" />
          <remove segment="App_LocalResources" />
          <remove segment="App_WebReferences" />
          <remove segment="App_Browsers" />
          <remove segment=".git" />
          <remove segment=".svn" />
          <add segment="web.config" />
          <add segment="bin" />
          <add segment="App_Code" />
          <add segment="App_Data" />
          <add segment="App_GlobalResources" />
          <add segment="App_LocalResources" />
          <add segment="App_WebReferences" />
          <add segment="App_Browsers" />
          <add segment=".git" />
          <add segment=".svn" />
        </hiddenSegments>
        <verbs allowUnlisted="false" applyToWebDAV="true">
          <clear />
          <add verb="GET" allowed="true" />
          <add verb="HEAD" allowed="true" />
          <add verb="POST" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>
    <modules runAllManagedModulesForAllRequests="true">
      <remove name="WebDAVModule" />
    </modules>
    <handlers accessPolicy="Read,Script">
      <clear />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="GET,HEAD,POST"
           type="System.Web.Handlers.TransferRequestHandler" resourceType="Unspecified" requireAccess="Script"
           preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>
</configuration>
